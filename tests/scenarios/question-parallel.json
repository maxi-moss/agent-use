{
  "name": "question-parallel",
  "steps": [
    {"op": "seed_session", "name": "s1"},
    {"op": "seed_session", "name": "s2", "pane_id": "%42"},
    {"op": "start_socket", "session": "s1"},
    {"op": "start_socket", "session": "s2"},
    {"op": "escalate", "session": "s1", "escalation_id": "e1", "expect": "ack"},
    {"op": "assert_surfaced", "escalation_id": "e1"},
    {"op": "assert_depth", "depth": 1, "waiting": []},
    {"op": "question_escalate", "session": "s2", "escalation_id": "q1", "question": "Which table layout?", "expect": "ack"},
    {"op": "assert_surfaced", "escalation_id": "q1"},
    {"op": "assert_open_panes", "kind": "question", "session_ids": ["s2"]},
    {"op": "assert_depth", "depth": 1, "waiting": []},
    {"op": "dispatch", "escalation_id": "q1", "decision": "the first one", "expect": "refused"},
    {"op": "assert_no_dispatch_write", "session": "s2"},
    {"op": "pane_retract", "session": "s2", "escalation_id": "q1", "reason": "answered in pane"},
    {"op": "assert_open_panes", "kind": "question", "session_ids": []},
    {"op": "assert_depth", "depth": 1, "waiting": []},
    {"op": "dispatch", "escalation_id": "e1", "decision": "go ahead", "expect": "dispatched"},
    {"op": "deliver", "session": "s1", "escalation_id": "e1"},
    {"op": "assert_depth", "depth": 0, "waiting": []},
    {"op": "assert_isolated"}
  ]
}
